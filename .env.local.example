# Copy this file to .env.local and fill in the values.

# Neon Postgres connection string.
# Use the pooled serverless connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Clerk authentication keys (https://dashboard.clerk.com).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Signing secret from the Clerk Dashboard webhook endpoint for /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Auth route URLs (optional; defaults match these paths).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/after-auth"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/after-auth"

# In Clerk Dashboard → Sessions → Customize session token, add:
# { "metadata": "{{user.public_metadata}}" }
# so middleware can read publicMetadata.role without a DB round-trip.

# ── File storage (posters, resumes, photos) ──────────────────────────────
# Any S3-compatible bucket. Cloudflare R2 recommended (10 GB free, no egress):
#   R2 → Create bucket (keep it private) → Manage R2 API tokens →
#   "Object Read & Write" for that bucket.
# Leave S3_BUCKET empty in local dev to store files in ./.uploads instead.
S3_BUCKET=""
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Email notifications (Resend, https://resend.com) ─────────────────────
# Without RESEND_API_KEY, emails are only logged to the server console.
RESEND_API_KEY=""
# Must be on a domain verified in Resend (add its DNS records for pinnaclerecruit.sg).
EMAIL_FROM="Pinnacle Recruitment <jobs@pinnaclerecruit.sg>"
# Who gets "new application" alerts (comma-separated).
STAFF_NOTIFY_EMAIL="info@pinnaclerecruit.sg"
# Public URL of the site, used for links inside emails.
# Use the Vercel URL (https://<project>.vercel.app) until the domain switches over.
APP_URL="https://pinnaclerecruit.sg"
